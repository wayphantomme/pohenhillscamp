# Cloudinary — REQUIRED for migrate:media and for production image delivery
# Get these from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=zktumplt
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# This env var is used by next-cloudinary and client-side URL building
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=zktumplt

# WordPress source (read-only, for migration scripts)
NEXT_PUBLIC_WP_BASE_URL=https://moccasin-wombat-987069.hostingersite.com

# Production URL of the Next.js site (used for sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://pohenhillscamp.com
